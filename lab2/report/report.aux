\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Сайт связывания 3QRJ: ребастиниб (зелёным) и Ile315 (оранжевым). Разветвлённая боковая цепь изолейцина занимает заметно больший объём, чем гидроксильная группа треонина на предыдущем рисунке.}}{9}{figure.caption.6}\protected@file@percent }
