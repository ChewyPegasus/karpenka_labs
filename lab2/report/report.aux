\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Наложение C$\alpha $-следов 2HYY (WT, синий) и 3QRJ (T315I, оранжевый). Общая укладка совпадает практически полностью.}}{11}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {16}Локальное сравнение позиции мутации}{12}{section.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Thr315 (синий) и Ile315 (оранжевый) после наложения. Основная цепь совпадает (отклонение C$\alpha $ 0{,}386~\r A), но боковая цепь изолейцина разветвлена и уходит заметно дальше в сторону кармана, где у WT располагается часть молекулы иматиниба (серым).}}{12}{figure.caption.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Отклонение C$\alpha $ по остаткам после наложения. Почти на всём протяжении цепи оно меньше 1~\r A. Выброс до 8~\r A{} приходится на остатки 389--400 --- петлю активации (381--405), выделенную серым. В позиции 315 (вертикальная оранжевая линия) отклонение минимально.}}{13}{figure.caption.9}\protected@file@percent }
